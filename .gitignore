# Patterns without a leading slash apply in every subfolder.

# Data: always re-downloadable, far too large for Git
data/

# Secrets: broker settings and the shared key, never commit
harnessv2/duc.env

# Environments
.venv/
.venv-*/

# Generated files
sample_run/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Large run outputs (keep small metric files, drop checkpoints and big logs)
results/**/checkpoints/
*.log

# Editor and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
# Harness: saved message bodies and model checkpoints
results/**/payloads/
results/**/checkpoint.npz
results/**/state.json

# Local databases and archives
*.sqlite
*.zip

# Regenerated listing from the audit's inventory script
audit/mappings/sensor_inventory_latest.csv
